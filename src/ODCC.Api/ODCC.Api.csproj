<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ریشه‌ی ترکیب (Composition Root):
    تنها جایی است که تمام لایه‌ها به هم وصل می‌شوند.
    کنترلرها، میان‌افزارها، احراز هویت و میزبان SPA.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- متد AddDbContextCheck<> (بررسی سلامت SQL Server) را فراهم می‌کند. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!--
      ابزارهای EF Core (dotnet ef) برای کار به این پکیج در پروژه‌ی راه‌انداز نیاز دارند.
      این پروژه startup پروژه‌ی ابزار است و این پکیج از Infrastructure به‌صورت
      PrivateAssets=all منتقل نمی‌شود. فقط ابزار طراحی است و در runtime استفاده نمی‌شود.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
