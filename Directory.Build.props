<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- مدیریت مرکزی نسخه‌ها: تمام نسخه‌ها در Directory.Packages.props تعریف می‌شوند. -->
    <EnableCentralPackageManagement>true</EnableCentralPackageManagement>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    لایه‌بندی معماری تمیز: یک پروژه فقط می‌تواند به لایه‌های مجاز ارجاع دهد.
    این قواعد در ODCC.Architecture.Tests به‌صورت خودکار نیز بررسی می‌شوند.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ODCC.Domain'">
    <!-- لایه دامنه: هیچ وابستگی به پروژه دیگر ندارد. -->
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ODCC.Application'">
    <ProjectReference Include="..\ODCC.Domain\ODCC.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ODCC.Infrastructure'">
    <ProjectReference Include="..\ODCC.Application\ODCC.Application.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ODCC.Api'">
    <ProjectReference Include="..\ODCC.Application\ODCC.Application.csproj" />
    <ProjectReference Include="..\ODCC.Infrastructure\ODCC.Infrastructure.csproj" />
  </ItemGroup>

</Project>
