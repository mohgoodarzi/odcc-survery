<Project Sdk="Microsoft.NET.Sdk">

  <!--
    آزمون‌های لایه‌ی کاربرد: مرز دامنه‌ی سازمانی (OrgScope) و منطق مجوزها.
    این آزمون‌ها پایگاه‌داده ندارند چون OrgScope یک شیء خالص (record) است
    و تمام رفتار امنیتی آن باید به‌صورت قطعی تست شود.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- روش نام‌گذاری آزمون‌های xUnit از زیرخط استفاده می‌کند. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ODCC.Application\ODCC.Application.csproj" />
    <ProjectReference Include="..\..\src\ODCC.Domain\ODCC.Domain.csproj" />
  </ItemGroup>

</Project>
